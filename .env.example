# NobleClean-Ops environment template
# Placeholder values only. Copy to .env.local for local development.
# Never commit filled .env files.

# Browser-exposed Supabase values. These are low-privilege publishable values
# and are safe only when Supabase Row Level Security is enabled and tested.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<replace-with-dev-or-preview-key>

# Non-secret comma-separated hostnames accepted by the app proxy.
# Production must set this to the real domain(s), for example:
# NOBLECLEAN_ALLOWED_HOSTS=ops.nobleclean.example
NOBLECLEAN_ALLOWED_HOSTS=localhost

# Server-only elevated Supabase key. Never prefix with NEXT_PUBLIC_.
# Use only in narrowly scoped server code that truly requires privileged
# Supabase operations, such as admin-managed user provisioning.
SUPABASE_SECRET_KEY=sb_secret_<replace-with-server-only-dev-or-preview-key>

# Optional migration/tooling connection string. Do not expose to the browser.
# Do not configure in Vercel runtime unless a specific server-side task needs it.
SUPABASE_DB_URL=postgresql://<user>:<password>@<host>:5432/<database>
